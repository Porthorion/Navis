<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- Profile-only deterministic SAF tree used by authenticated emulator
             diagnostics. It is not part of stable or debug builds. -->
        <provider
            android:name=".NavisDiagnosticsDocumentsProvider"
            android:authorities="${applicationId}.diagnostics.documents"
            android:exported="false"
            android:grantUriPermissions="true">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
