        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"play_queue_items\" (\"queue_id\" INTEGER NOT NULL REFERENCES play_queue (id) ON DELETE CASCADE, \"song_id\" TEXT NOT NULL REFERENCES songs (id) ON DELETE CASCADE, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"queue_id\", \"sort_order\"));"
        }
      ]
