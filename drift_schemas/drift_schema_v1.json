    {
      "name": "server_config",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"server_config\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NULL, \"url\" TEXT NOT NULL, \"username\" TEXT NOT NULL, \"api_version\" TEXT NOT NULL, \"capabilities\" TEXT NULL, \"last_synced\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "artists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"artists\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"album_count\" INTEGER NULL, \"cover_art\" TEXT NULL, \"starred\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "albums",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"albums\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"artist_id\" TEXT NULL REFERENCES artists (id) ON DELETE SET NULL, \"artist_name\" TEXT NULL, \"song_count\" INTEGER NULL, \"duration\" INTEGER NULL, \"year\" INTEGER NULL, \"genre\" TEXT NULL, \"cover_art\" TEXT NULL, \"starred\" INTEGER NULL, \"play_count\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "songs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"songs\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"album_id\" TEXT NULL REFERENCES albums (id) ON DELETE SET NULL, \"artist_id\" TEXT NULL REFERENCES artists (id) ON DELETE SET NULL, \"artist_name\" TEXT NULL, \"album_name\" TEXT NULL, \"track\" INTEGER NULL, \"disc_number\" INTEGER NULL, \"duration\" INTEGER NULL, \"bit_rate\" INTEGER NULL, \"content_type\" TEXT NULL, \"suffix\" TEXT NULL, \"size\" INTEGER NULL, \"cover_art\" TEXT NULL, \"starred\" INTEGER NULL, \"play_count\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "genres",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"genres\" (\"name\" TEXT NOT NULL, \"song_count\" INTEGER NULL, \"album_count\" INTEGER NULL, PRIMARY KEY (\"name\"));"
        }
      ]
    },
    {
      "name": "playlists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlists\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"song_count\" INTEGER NULL, \"duration\" INTEGER NULL, \"owner\" TEXT NULL, \"is_public\" INTEGER NULL CHECK (\"is_public\" IN (0, 1)), \"cover_art\" TEXT NULL, \"comment\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "playlist_songs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlist_songs\" (\"playlist_id\" TEXT NOT NULL REFERENCES playlists (id) ON DELETE CASCADE, \"song_id\" TEXT NOT NULL REFERENCES songs (id) ON DELETE CASCADE, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"playlist_id\", \"song_id\"));"
        }
      ]
    },
    {
      "name": "cached_tracks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_tracks\" (\"song_id\" TEXT NOT NULL REFERENCES songs (id) ON DELETE CASCADE, \"file_path\" TEXT NOT NULL, \"file_size\" INTEGER NOT NULL, \"format\" TEXT NOT NULL, \"bit_rate\" INTEGER NULL, \"last_accessed_at\" INTEGER NOT NULL, \"cache_type\" TEXT NOT NULL, \"download_status\" TEXT NOT NULL, PRIMARY KEY (\"song_id\"));"
        }
      ]
    },
    {
      "name": "download_queue",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"download_queue\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"song_id\" TEXT NULL REFERENCES songs (id) ON DELETE SET NULL, \"album_id\" TEXT NULL REFERENCES albums (id) ON DELETE SET NULL, \"playlist_id\" TEXT NULL REFERENCES playlists (id) ON DELETE SET NULL, \"quality\" TEXT NULL, \"format\" TEXT NULL, \"status\" TEXT NOT NULL, \"progress\" REAL NOT NULL DEFAULT 0.0, \"added_at\" INTEGER NOT NULL, \"priority\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "play_history",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"play_history\" (\"song_id\" TEXT NOT NULL REFERENCES songs (id) ON DELETE CASCADE, \"played_at\" INTEGER NOT NULL, PRIMARY KEY (\"song_id\", \"played_at\"));"
        }
      ]
    },
    {
      "name": "recent_searches",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recent_searches\" (\"query\" TEXT NOT NULL, \"searched_at\" INTEGER NOT NULL, PRIMARY KEY (\"query\"));"
        }
      ]
    },
    {
      "name": "play_queue",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"play_queue\" (\"id\" INTEGER NOT NULL, \"current_index\" INTEGER NULL, \"shuffle_mode\" TEXT NOT NULL DEFAULT 'off', \"repeat_mode\" TEXT NOT NULL DEFAULT 'off', \"position_ms\" INTEGER NOT NULL DEFAULT 0, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "play_queue_items",
