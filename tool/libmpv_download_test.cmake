# Offline checks: file(DOWNLOAD) is replaced with deterministic local fixtures.
cmake_minimum_required(VERSION 3.18)
set(source "${CMAKE_CURRENT_LIST_DIR}/../third_party/media_kit_libs_windows_audio/windows/CMakeLists.txt")
if(DEFINED DOWNLOAD_SOURCE)
  set(source "${DOWNLOAD_SOURCE}")
endif()
file(READ "${source}" contents)
string(REGEX MATCH "function\\(download_and_verify[^\n]*\\)[\n\r].*\nendfunction\\(\\)" download_function "${contents}")
# Restrict the match to the first function (the Windows file has more helpers).
string(FIND "${download_function}" "endfunction()" function_end)
math(EXPR function_end "${function_end} + 13")
string(SUBSTRING "${download_function}" 0 ${function_end} download_function)
cmake_language(EVAL CODE "${download_function}")
set(work "${CMAKE_CURRENT_BINARY_DIR}/libmpv-download-fixture")
file(MAKE_DIRECTORY "${work}")
set(archive "${work}/archive")
file(WRITE "${archive}" "verified fixture")
file(SHA256 "${archive}" expected)
set_property(GLOBAL PROPERTY attempts 0)

function(file)
  if(ARGV0 STREQUAL "DOWNLOAD")
    if(EXISTS "${ARGV2}")
      message(FATAL_ERROR "Failed archive was not deleted before retry")
    endif()
    get_property(attempts GLOBAL PROPERTY attempts)
    math(EXPR attempts "${attempts} + 1")
    set_property(GLOBAL PROPERTY attempts ${attempts})
    if(attempts EQUAL 1 OR FAIL_MODE)
      _file(WRITE "${ARGV2}" "partial download")
      set(DOWNLOAD_STATUS "7;simulated failure" PARENT_SCOPE)
    elseif(attempts EQUAL 2)
      _file(WRITE "${ARGV2}" "incorrect digest")
      set(DOWNLOAD_STATUS "0;OK" PARENT_SCOPE)
    else()
      _file(WRITE "${ARGV2}" "verified fixture")
      set(DOWNLOAD_STATUS "0;OK" PARENT_SCOPE)
    endif()
  else()
    _file(${ARGV})
    if(ARGV0 STREQUAL "SHA256")
      set("${ARGV2}" "${${ARGV2}}" PARENT_SCOPE)
    endif()
  endif()
endfunction()

set(urls "first;second;third")
if(FAIL_MODE)
  file(REMOVE "${archive}")
  download_and_verify("${urls}" "${expected}" "${archive}")
  message(FATAL_ERROR "Exhausted URLs did not fail")
endif()
download_and_verify("${urls}" "${expected}" "${archive}")
get_property(attempts GLOBAL PROPERTY attempts)
if(NOT attempts EQUAL 0)
  message(FATAL_ERROR "Verified cache was not reused offline")
endif()
file(WRITE "${archive}" "invalid cache")
download_and_verify("${urls}" "${expected}" "${archive}")
get_property(attempts GLOBAL PROPERTY attempts)
if(NOT attempts EQUAL 3)
  message(FATAL_ERROR "Fallback URLs were not tried in order")
endif()
file(SHA256 "${archive}" actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Fallback accepted an incorrect digest")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -DFAIL_MODE=ON
  "-DDOWNLOAD_SOURCE=${source}" -P "${CMAKE_CURRENT_LIST_FILE}"
  RESULT_VARIABLE failure OUTPUT_QUIET ERROR_QUIET)
if(failure EQUAL 0 OR EXISTS "${archive}")
  message(FATAL_ERROR "Exhausted URLs must fail and remove the bad archive")
endif()
file(REMOVE_RECURSE "${work}")
message(STATUS "Offline libmpv cache, fallback and cleanup checks passed")
