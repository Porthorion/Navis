# tool/release.env — copy this file to tool/release.env and fill in your values.
# tool/release.env is git-ignored; this example file is tracked.

# Base URL of your Forgejo instance (no trailing slash).
FORGEJO_URL=https://git.porthorion.com

# "owner/repo" — must match the repository path on Forgejo.
FORGEJO_REPO=khalifa/Navis

# Forgejo API token with "write:release" scope.
# Create at: https://git.porthorion.com/user/settings/applications
FORGEJO_TOKEN=your_token_here

# Last.fm API key for Same Vibes recommendations.
# Required for Android releases (validated by tool/release.sh).
# NAVIS_LASTFM_API_KEY=your_lastfm_api_key

# Optional: bundled Voyage servers for Listen Together.
# Format: comma/newline separated URLs, with optional labels as Label|URL.
# Example:
# NAVIS_VOYAGE_SERVERS="Primary Voyage|https://voyage.example.com,Backup Voyage|https://voyage-backup.example.com"

# Optional: maintainer metadata injected into Linux .deb control file.
# NAVIS_DEB_MAINTAINER="Navis Team <release@example.com>"

# Optional: remote builders used when running release.sh on macOS for Linux/Windows assets.
# Targets are SSH endpoints, typically local VMs running on the same Mac.
# NAVIS_LINUX_SSH="linux-builder"
# NAVIS_WINDOWS_SSH="windows-builder"
#
# Optional remote working directories (relative to remote HOME).
# NAVIS_LINUX_REMOTE_DIR=".navis/remote-linux-build"
# NAVIS_WINDOWS_REMOTE_DIR=".navis/remote-windows-build"

# Optional: required when using --macos-notarize.
# Use a Developer ID Application certificate identity from your keychain.
# MACOS_SIGN_IDENTITY="Developer ID Application: Your Company (TEAMID)"
#
# notarytool keychain profile name:
#   xcrun notarytool store-credentials <profile_name> --apple-id ... --team-id ... --password ...
# MACOS_NOTARY_PROFILE="navis-notary-profile"
