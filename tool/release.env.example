# tool/release.env — copy this file to tool/release.env and fill in your values.
# tool/release.env is git-ignored; this example file is tracked.

# R2 update channel (Navis 1.5.0+). tool/r2_publish.sh uploads release files and
# the signed manifest to the shared "downloads" bucket under R2_PREFIX, served at
# https://downloads.porthorion.com/navis/. See docs/release/release-r2.md.
# The access key pair is an R2 API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET=downloads
R2_PREFIX=navis
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Ed25519 private key that signs update manifests. Keep it outside the repo
# (chmod 600) with an offline backup; its public half is pinned in
# lib/src/utils/constants.dart (updateSigningPublicKey).
NAVIS_UPDATE_SIGNING_KEY=${HOME}/.config/navis/update-signing-ed25519.pem
# Optional: https link shown as "release notes" in the update dialog.
# NAVIS_RELEASE_NOTES_URL=https://navis.porthorion.com/download

# Forgejo is only used with release.sh --forgejo (the 1.5.0 bridge release
# that 1.4.x installs find through the Forgejo releases API).
# Base URL of your Forgejo instance (no trailing slash).
FORGEJO_URL=https://git.porthorion.com

# "owner/repo" — must match the repository path on Forgejo.
FORGEJO_REPO=khalifa/Navis

# Forgejo API token with "write:release" scope.
# Create at: https://git.porthorion.com/user/settings/applications
FORGEJO_TOKEN=your_token_here

# Last.fm API key bundled into release builds (Same Vibes, artist top songs,
# and the other Last.fm features). Required for Android and Play releases.
# The build masks it (key XOR a per-build random pad) and passes it through a
# private defines file, and tool/release.sh fails if the plaintext key appears
# in any artifact. This deters casual extraction; it is not secrecy. A Last.fm
# API key is a client identifier and no shared secret is used.
# NAVIS_LASTFM_API_KEY=your_lastfm_api_key

# Google Play upload automation (local only; never commit real paths/secrets).
# PLAY_SERVICE_ACCOUNT_JSON=/absolute/path/google-play-service-account.json
# PLAY_PACKAGE_NAME=com.navis.app.navis
# tool/play_release.sh defaults to --play-track=internal --play-status=draft.
# Use --dry-run to build the AAB without creating a Play edit.
# Track aliases: closed -> alpha, open -> beta.
# Staged rollout example:
#   tool/play_release.sh --play-track=production --play-status=inProgress --play-user-fraction=0.05

# Optional: maintainer metadata injected into Linux .deb control file.
# NAVIS_DEB_MAINTAINER="Porthorion <support@porthorion.com>"

# Optional: remote builders used when running release.sh on macOS for Linux/Windows assets.
# Targets are SSH endpoints, typically local VMs running on the same Mac.
# NAVIS_LINUX_SSH="linux-builder"
# NAVIS_WINDOWS_SSH="windows-builder"
#
# Optional remote working directories (relative to remote HOME).
# NAVIS_LINUX_REMOTE_DIR=".navis/remote-linux-build"
# NAVIS_WINDOWS_REMOTE_DIR=".navis/remote-windows-build"

# Optional: required when using --macos-notarize.
# Use a Developer ID Application certificate identity from your keychain.
# MACOS_SIGN_IDENTITY="Developer ID Application: Your Company (TEAMID)"
#
# notarytool keychain profile name:
#   xcrun notarytool store-credentials <profile_name> --apple-id ... --team-id ... --password ...
# MACOS_NOTARY_PROFILE="navis-notary-profile"
