# tool/release.env — copy this file to tool/release.env and fill in your values.
# tool/release.env is git-ignored; this example file is tracked.

# Base URL of your Forgejo instance (no trailing slash).
FORGEJO_URL=https://git.porthorion.com

# "owner/repo" — must match the repository path on Forgejo.
FORGEJO_REPO=khalifa/Navis

# Forgejo API token with "write:release" scope.
# Create at: https://git.porthorion.com/user/settings/applications
FORGEJO_TOKEN=your_token_here
