# Exercises the real Linux bundle block against a local archive; no downloads.
cmake_minimum_required(VERSION 3.18)
file(READ "${CMAKE_CURRENT_LIST_DIR}/../linux/CMakeLists.txt" contents)
string(FIND "${contents}" "# A relocatable LGPL audio backend" start)
string(FIND "${contents}" "# === Installation ===" end)
math(EXPR length "${end} - ${start}")
string(SUBSTRING "${contents}" ${start} ${length} bundle_block)
string(REGEX MATCH "if\\(NAVIS_BUNDLE_LIBMPV\\)\n  install\\(FILES[^\n]*\n    DESTINATION[^\n]*\nendif\\(\\)" install_block "${contents}")
if(NOT install_block)
  message(FATAL_ERROR "Bundled libmpv install rule not found")
endif()
set(work "${CMAKE_CURRENT_BINARY_DIR}/libmpv-bundle-fixture")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/source/libmpv-linux-x86_64-lgpl" "${work}/build")
file(WRITE "${work}/source/libmpv-linux-x86_64-lgpl/libmpv.so.2" "fixture library")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf
  "${work}/build/libmpv-linux-x86_64-lgpl-20261007.tar.gz"
  libmpv-linux-x86_64-lgpl WORKING_DIRECTORY "${work}/source"
  RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Fixture archive creation failed")
endif()
file(SHA256 "${work}/build/libmpv-linux-x86_64-lgpl-20261007.tar.gz" digest)
string(REPLACE "759bb6586b4d772bb78a565609dcccc5205741c8b1163c1d47ed3493bf227f6e"
  "${digest}" bundle_block "${bundle_block}")
# Assert any attempted download fails immediately rather than contacting hosts.
file(WRITE "${work}/source/CMakeLists.txt" "cmake_minimum_required(VERSION 3.18)
project(fixture NONE)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
function(file)
  if(ARGV0 STREQUAL \"DOWNLOAD\")
    message(FATAL_ERROR \"Unexpected network attempt\")
  else()
    _file(\${ARGV})
    if(ARGV0 STREQUAL \"SHA256\")
      set(\"\${ARGV2}\" \"\${\${ARGV2}}\" PARENT_SCOPE)
    endif()
  endif()
endfunction()
${bundle_block}
set(INSTALL_BUNDLE_LIB_DIR \"\${CMAKE_INSTALL_PREFIX}/lib\")
${install_block}
")
function(configure_fixture)
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${work}/source" -B "${work}/build"
    "-DCMAKE_INSTALL_PREFIX=${work}/installed" ${ARGN}
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE errors)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Fixture configure failed: ${errors}")
  endif()
endfunction()
configure_fixture()
set(extracted "${work}/build/libmpv-linux-x86_64-lgpl-20261007")
if(NOT EXISTS "${extracted}/.extracted")
  message(FATAL_ERROR "Archive was not extracted")
endif()
file(WRITE "${extracted}/kept" "reuse marker")
configure_fixture()
if(NOT EXISTS "${extracted}/kept")
  message(FATAL_ERROR "Archive was extracted again for the same pin")
endif()
file(REMOVE "${extracted}/libmpv-linux-x86_64-lgpl/libmpv.so.2")
configure_fixture()
if(EXISTS "${extracted}/kept")
  message(FATAL_ERROR "Incomplete extraction was not repaired")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${work}/build"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE errors)
if(NOT result EQUAL 0 OR NOT EXISTS "${work}/installed/lib/libmpv.so.2")
  message(FATAL_ERROR "Bundle did not install in lib/: ${errors}")
endif()
file(REMOVE_RECURSE "${work}/build" "${work}/installed")
configure_fixture(-DNAVIS_BUNDLE_LIBMPV=OFF)
if(EXISTS "${extracted}")
  message(FATAL_ERROR "Opt-out unexpectedly extracted a bundle")
endif()
file(REMOVE_RECURSE "${work}")
message(STATUS "Offline Linux extraction, reuse, repair, install and opt-out checks passed")
