# Copy to .env next to compose.yaml (host only, never commit real values).
# Shell-sourced by bootstrap.sh and read by docker compose: use plain values
# (avoid $, # and spaces) or quote them.
COMPOSE_PROJECT_NAME=navis-demo
DEMO_UID=1000
DEMO_GID=1000
DEMO_PORT=4535
# Loopback port for the temporary bootstrap-mode container (never the public port).
DEMO_BOOT_PORT=4536
# Absolute host paths; DEMO_UID must own DATA, SEED and MASTER, and read MUSIC.
DEMO_DATA_DIR=/path/to/demo/data
DEMO_SEED_DIR=/path/to/demo/seed
DEMO_MUSIC_DIR=/path/to/demo/music
# Master seed (has the admin). Mode 700, never mounted into the container.
DEMO_MASTER_DIR=/path/to/demo/master
# Required, no default: generate with `openssl rand -hex 32`. Losing it
# invalidates the seeded passwords.
ND_PASSWORDENCRYPTIONKEY=
# Where bootstrap.sh writes the random admin login (mode 600, outside the repo).
DEMO_ADMIN_CREDS_FILE=/path/to/demo/admin-credentials
# Reviewer login, needed only for the first bootstrap and rotate-reviewer
# (pass the new password in the environment instead). Remove after use.
DEMO_REVIEWER_USER=reviewer
DEMO_REVIEWER_PASSWORD=
